# Copy this file to .env and fill in real values.
# Taskfile.yaml loads .env automatically (see the `dotenv` key), so these
# become available to tasks like `task deploy` without exporting them by hand.

# SSH target with key-based access and root (or equivalent) privileges.
SERVER=root@geidelguerra.com

# Hostname nginx should listen for on the server.
DOMAIN=geidelguerra.com

# Cloudflare account ID (not secret) and an API Token — used by:
# - `wrangler` (deploy_cloudflare.sh) for non-interactive auth, if set.
# - the "Ask about this website" widget's POST /api/ask (see internal/ask),
#   on every deployment: the API Token must be able to call Workers AI.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Secret key for the ask widget's Turnstile sitekey (see
# internal/web/views/ask.templ's AskTurnstileSiteKey), used to verify
# POST /api/ask's Turnstile tokens server-side. Get/rotate it from
# https://dash.cloudflare.com/?to=/:account/turnstile.
TURNSTILE_SECRET_KEY=
