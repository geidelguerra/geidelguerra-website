package views

import "github.com/geidelguerra/website/internal/data"

// AskWidget renders the "Ask about this website" widget: a floating button
// that opens a small search panel. There is no model, no network call, and
// no server involved in answering questions: the site's content is
// pre-indexed once at render time (see ask_search.go) and embedded
// directly in the page as JSON, and static/js/ask.js does a small, fast,
// fuzzy client-side search over it, so results appear instantly. The panel
// closes on its own toggle button, on Escape, or on a click outside it.
templ AskWidget(d *data.Data) {
	<div id="ask-widget" class="ask-widget" hidden>
		@templ.JSONScript("ask-search-index", buildSearchIndex(d))
		<div id="ask-panel" class="ask-panel" hidden>
			<form id="ask-form" class="ask-form">
				<input
					id="ask-input"
					class="ask-input"
					type="text"
					name="question"
					placeholder="Ask about this website"
					autocomplete="off"
				/>
				<button id="ask-submit" class="ask-submit" type="submit" aria-label="Ask">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
						<path d="M5 12h14M13 6l6 6-6 6"></path>
					</svg>
				</button>
			</form>
			<div id="ask-results" class="ask-answer" aria-live="polite" hidden></div>
		</div>
		<button
			id="ask-toggle"
			class="ask-toggle"
			type="button"
			aria-label="Ask about this website"
			aria-expanded="false"
			aria-controls="ask-panel"
		>
			<svg class="icon icon-ask-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
			</svg>
			<svg class="icon icon-ask-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M18 6 6 18M6 6l12 12"></path>
			</svg>
		</button>
	</div>
}
